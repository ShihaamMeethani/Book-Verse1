<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (API 28+) blocks plain HTTP (cleartext) by default, which is
  why ChatService's default dev URL (http://10.0.2.2:8000) fails silently
  with no useful error. This file allows cleartext ONLY to local dev hosts
  (the Android-emulator alias for your machine, plus localhost) so the
  chatbot works during development. It does NOT relax security for any
  other domain, and does not affect Firebase/Firestore traffic.

  Once you deploy server/ behind HTTPS, update ChatService's baseUrl to
  https:// and you can remove this file and the manifest reference to it.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
